# ── EXODUS .gitignore ──────────────────────────────────
# Public repo: pipeline code + explorer UI + tests
# Private: all data, results, candidate info, strategy docs

# ── Python ─────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# ── Node / Frontend ───────────────────────────────────
explorer/frontend/node_modules/
explorer/frontend/dist/

# ── Data (contains target coordinates & results) ──────
data/
logs/
run.log
results.tsv
autoresearch_run.log
autoresearch_results.tsv
*.log
notebooks/

# ── Project strategy & memory (private) ───────────────
.exodus_meta/
.claude/
TODO.md

# ── Paper & outreach (private) ─────────────────────────
docs/paper*.md
docs/email_draft*.md
docs/*_summary_for_*
docs/candidate_*
docs/*dossier*
docs/*onepager*
docs/*redacted*
docs/*proposal*
docs/private/
docs/archive/
docs/exodus_summary*

# ── Private program / analysis files ─────────────────
program.md

# ── OS / IDE ──────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# ── Private analysis scripts (not part of core pipeline) ─
scripts/private/
scripts/generate_candidate*.py
scripts/generate_exodus_summary.py
scripts/calibrate_irvar_only.py
scripts/neowise_lomb_scargle.py

# ── Large / binary files ─────────────────────────────
*.pkl
*.h5
*.fits
*.csv
*.parquet
